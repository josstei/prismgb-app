{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@main/*": [
        "src/main/*"
      ],
      "@renderer/*": [
        "src/renderer/*"
      ],
      "@preload/*": [
        "src/preload/*"
      ],
      "@prismgb/gpu": [
        "packages/prismgb-gpu/src"
      ],
      "@prismgb/gpu/*": [
        "packages/prismgb-gpu/src/*"
      ],
      "@prismgb/core": [
        "packages/prismgb-core/src"
      ],
      "@prismgb/core/*": [
        "packages/prismgb-core/src/*"
      ],
      "@prismgb/di": [
        "packages/prismgb-di/src"
      ],
      "@prismgb/di/*": [
        "packages/prismgb-di/src/*"
      ],
      "@prismgb/ipc": [
        "packages/prismgb-ipc/src"
      ],
      "@prismgb/ipc/*": [
        "packages/prismgb-ipc/src/*"
      ],
      "@prismgb/devices": [
        "packages/prismgb-devices/src"
      ],
      "@prismgb/devices/*": [
        "packages/prismgb-devices/src/*"
      ],
      "@prismgb/stream-source": [
        "packages/prismgb-stream-source/src"
      ],
      "@prismgb/stream-source/*": [
        "packages/prismgb-stream-source/src/*"
      ]
    },
    "types": [
      "node",
      "vite/client"
    ],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ]
  }
}
