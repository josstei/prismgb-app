{
  "name": "prismgb",
  "version": "1.2.1",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=22.12"
  },
  "description": "Desktop UI for playing with the Mod Retro Chromatic",
  "main": "dist/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "node scripts/patch-mac-app-name.js && vite",
    "build": "npm run build:vite && electron-builder",
    "build:vite": "npm run clean:build && vite build",
    "build:win": "npm run build:vite && electron-builder --win",
    "build:mac": "npm run build:vite && electron-builder --mac",
    "build:linux": "npm run build:vite && electron-builder --linux",
    "preview": "vite preview",
    "start": "electron dist/main/index.js",
    "lint": "eslint \"src/**/*.ts\" && depcruise --config .dependency-cruiser.cjs src",
    "lint:fix": "eslint \"src/**/*.ts\" --fix && depcruise --config .dependency-cruiser.cjs src",
    "lint:dead-code": "knip",
    "packaging:check-native-abi": "node scripts/check-electron-native-abi.js",
    "clean:generated": "node scripts/clean-generated.js",
    "clean:build": "node scripts/clean-generated.js --build",
    "dev:smoke": "node scripts/dev-boot-smoke.js",
    "release:preflight": "npm run packaging:check-native-abi && npm run test:coverage && npm run dev:smoke",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "typecheck": "npm run typecheck:app && npm run typecheck:tests",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:run": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:integration:watch": "vitest tests/integration",
    "test:unit": "vitest run tests/unit",
    "test:smoke": "node scripts/smoke-test.js",
    "test:e2e": "npm run build:vite && npm run test:e2e:built",
    "test:e2e:built": "playwright test",
    "test:e2e:ui": "npm run build:vite && playwright test --ui",
    "test:e2e:headed": "npm run build:vite && playwright test --headed",
    "test:e2e:debug": "npm run build:vite && playwright test --debug",
    "prepare": "husky",
    "postinstall": "patch-package",
    "generate-icons": "node scripts/generate-icons.js"
  },
  "keywords": [
    "electron",
    "video-streaming",
    "video-capture",
    "usb",
    "mod-retro-chromatic"
  ],
  "author": {
    "name": "josstei",
    "email": "josstei@users.noreply.github.com"
  },
  "license": "MIT",
  "dependencies": {
    "@preact/signals-core": "^1.14.4",
    "@trpc/client": "^10.45.4",
    "@trpc/server": "^10.45.4",
    "comlink": "^4.4.2",
    "electron-log": "^5.4.4",
    "electron-trpc": "^0.7.1",
    "electron-updater": "^6.8.9",
    "eventemitter3": "^5.0.4",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "inversify": "^8.2.3",
    "usb": "^2.16.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.0.2",
    "@electron/notarize": "^2.5.0",
    "@eslint/js": "^10.0.1",
    "@inversifyjs/core": "^11.0.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.0.14",
    "@webgpu/types": "^0.1.71",
    "builder-util": "^26.8.1",
    "dependency-cruiser": "^18.0.0",
    "electron": "^41.10.7",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "happy-dom": "^20.10.6",
    "husky": "^9.1.7",
    "knip": "^6.26.0",
    "lint-staged": "^17.0.8",
    "patch-package": "^8.0.1",
    "picomatch": "^4.0.5",
    "png2icons": "^2.0.1",
    "sharp": "^0.35.2",
    "type-fest": "^5.8.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.0.14"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint"
    ],
    "*.{js,ts}": [
      "vitest related --run --passWithNoTests"
    ]
  },
  "build": {
    "appId": "com.prismgb",
    "productName": "PrismGB",
    "copyright": "Copyright © 2025",
    "compression": "maximum",
    "publish": {
      "provider": "github",
      "owner": "josstei",
      "repo": "prismgb-app",
      "releaseType": "draft"
    },
    "files": [
      "dist/**/*",
      "!dist/*-unpacked/**/*",
      "!dist/*.AppImage",
      "!dist/*.deb",
      "!dist/*.tar.gz",
      "!dist/*.dmg",
      "!dist/*.exe",
      "!dist/*.msi",
      "!dist/*.pkg",
      "!dist/*.zip",
      "!dist/*.snap",
      "!dist/*.blockmap",
      "!dist/latest-*.yml",
      "!dist/builder-debug.yml"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*",
      "node_modules/ffprobe-static/**/*",
      "node_modules/usb/prebuilds/**/*"
    ],
    "afterPack": "./scripts/afterPack.js",
    "artifactBuildCompleted": "./scripts/patch-appimage-runtime.js",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.icns",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "notarize": true
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "title": "${productName} ${version}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "category": "Utility",
      "icon": "assets/icon.png",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "PrismGB",
          "Comment": "Desktop UI for playing with the Mod Retro Chromatic",
          "Categories": "Utility;Video;"
        }
      }
    },
    "deb": {
      "depends": [
        "libusb-1.0-0",
        "zlib1g"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PrismGB",
      "perMachine": false,
      "runAfterFinish": true,
      "license": "LICENSE",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    }
  }
}
