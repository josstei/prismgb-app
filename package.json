{
  "name": "prismgb",
  "version": "1.2.1",
  "description": "Desktop UI for playing with the Mod Retro Chromatic",
  "main": "dist/main/index.js",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/patch-mac-app-name.js && vite",
    "build": "vite build && electron-builder",
    "build:vite": "vite build",
    "build:win": "vite build && electron-builder --win",
    "build:mac": "vite build && electron-builder --mac",
    "build:linux": "vite build && electron-builder --linux",
    "preview": "vite preview",
    "start": "electron dist/main/index.js",
    "lint": "eslint \"src/**/*.{js,ts}\" && node scripts/check-layer-boundaries.js",
    "lint:fix": "eslint \"src/**/*.{js,ts}\" --fix && node scripts/check-layer-boundaries.js",
    "architecture:scorecard": "node scripts/architecture-scorecard.js",
    "architecture:type-debt:report": "node scripts/type-debt-report.js --output artifacts/type-debt-current.json",
    "architecture:type-debt:check": "node scripts/typecheck-app.js --allowlist scripts/type-debt-allowlist.json",
    "typecheck:app": "node scripts/typecheck-app.js",
    "typecheck:gpu": "npm run typecheck --workspace=@prismgb/gpu",
    "typecheck": "npm run typecheck:app && npm run typecheck:gpu",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:run": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:integration:watch": "vitest tests/integration",
    "test:unit": "vitest run tests/unit",
    "test:all": "vitest run",
    "test:smoke": "node scripts/smoke-test.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "prepare": "husky",
    "generate-icons": "node scripts/generate-icons.js",
    "typecheck:app:allowlist": "node scripts/typecheck-app.js --write-allowlist scripts/type-debt-allowlist.json"
  },
  "keywords": [
    "electron",
    "video-streaming",
    "video-capture",
    "usb",
    "mod-retro-chromatic"
  ],
  "author": {
    "name": "josstei",
    "email": "josstei@users.noreply.github.com"
  },
  "license": "MIT",
  "dependencies": {
    "@prismgb/gpu": "*",
    "awilix": "^13.0.5",
    "electron-updater": "^6.8.9",
    "eventemitter3": "^5.0.4",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "joi": "^18.2.3",
    "usb-detection": "^4.14.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.0.2",
    "@electron/notarize": "^2.5.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.3",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.0.14",
    "electron": "^28.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.6.0",
    "happy-dom": "^20.10.6",
    "husky": "^9.1.7",
    "png2icons": "^2.0.1",
    "sharp": "^0.35.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-electron": "^1.0.4",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.0.14"
  },
  "build": {
    "appId": "com.prismgb",
    "productName": "PrismGB",
    "copyright": "Copyright © 2025",
    "compression": "maximum",
    "publish": {
      "provider": "github",
      "owner": "josstei",
      "repo": "prismgb-app",
      "releaseType": "draft"
    },
    "files": [
      "dist/**/*",
      "!dist/*-unpacked/**/*",
      "!dist/*.AppImage",
      "!dist/*.deb",
      "!dist/*.tar.gz",
      "!dist/*.dmg",
      "!dist/*.exe",
      "!dist/*.msi",
      "!dist/*.pkg",
      "!dist/*.zip",
      "!dist/*.snap",
      "!dist/*.blockmap",
      "!dist/latest-*.yml",
      "!dist/builder-debug.yml"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*",
      "node_modules/ffprobe-static/**/*"
    ],
    "afterPack": "./scripts/afterPack.js",
    "artifactBuildCompleted": "./scripts/patch-appimage-runtime.js",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.icns",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "notarize": true
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "title": "${productName} ${version}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "category": "Utility",
      "icon": "assets/icon.png",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "PrismGB",
          "Comment": "Desktop UI for playing with the Mod Retro Chromatic",
          "Categories": "Utility;Video;"
        }
      }
    },
    "deb": {
      "depends": [
        "libusb-1.0-0",
        "zlib1g"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PrismGB",
      "perMachine": false,
      "runAfterFinish": true,
      "license": "LICENSE",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    }
  }
}
