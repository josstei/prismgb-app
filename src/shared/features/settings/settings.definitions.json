{
  "version": 1,
  "mode": "report-only",
  "loadAllPreferencesShape": ["volume", "statusStripVisible", "performanceMode", "minimalistFullscreen"],
  "definitions": [
    {
      "name": "gameVolume",
      "storageKey": "gameVolume",
      "type": "number",
      "default": 70,
      "legacy": { "get": "getVolume", "set": "setVolume" },
      "validation": { "min": 0, "max": 100, "clamp": true },
      "event": "settings:volume-changed"
    },
    {
      "name": "statusStripVisible",
      "storageKey": "statusStripVisible",
      "type": "boolean",
      "default": false,
      "legacy": { "get": "getStatusStripVisible", "set": "setStatusStripVisible" }
    },
    {
      "name": "renderPreset",
      "storageKey": "renderPreset",
      "type": "string",
      "default": "vibrant",
      "legacy": { "get": "getRenderPreset", "set": "setRenderPreset" },
      "event": "settings:render-preset-changed"
    },
    {
      "name": "globalBrightness",
      "storageKey": "globalBrightness",
      "type": "number",
      "default": 1,
      "legacy": { "get": "getGlobalBrightness", "set": "setGlobalBrightness" },
      "validation": { "min": 0.5, "max": 1.5, "clamp": true },
      "event": "settings:brightness-changed"
    },
    {
      "name": "performanceMode",
      "storageKey": "performanceMode",
      "type": "boolean",
      "default": false,
      "legacy": { "get": "getPerformanceMode", "set": "setPerformanceMode" },
      "event": "settings:performance-mode-changed"
    },
    {
      "name": "fullscreenOnStartup",
      "storageKey": "fullscreenOnStartup",
      "type": "boolean",
      "default": false,
      "legacy": { "get": "getFullscreenOnStartup", "set": "setFullscreenOnStartup" }
    },
    {
      "name": "minimalistFullscreen",
      "storageKey": "minimalistFullscreen",
      "type": "boolean",
      "default": false,
      "legacy": { "get": "getMinimalistFullscreen", "set": "setMinimalistFullscreen" },
      "event": "settings:minimalist-fullscreen-changed"
    },
    {
      "name": "autoStreamOnConnect",
      "storageKey": "autoStreamOnConnect",
      "type": "boolean",
      "default": false,
      "legacy": { "get": "getAutoStreamOnConnect", "set": "setAutoStreamOnConnect" }
    },
    {
      "name": "recordingFormat",
      "storageKey": "recordingFormat",
      "type": "enum",
      "default": "webm",
      "allowedValues": ["webm", "mp4", "mov"],
      "allowedValuesSource": "TRANSCODE_CONFIG.formats",
      "legacy": { "get": "getRecordingFormat", "set": "setRecordingFormat" },
      "event": "settings:recording-format-changed",
      "compatibilityNotes": ["Default intentionally remains webm even though TRANSCODE_CONFIG.defaultFormat is mp4."]
    },
    {
      "name": "launchOnLogin",
      "storageKey": "launchOnLogin",
      "type": "boolean",
      "default": false,
      "legacy": { "get": "getLaunchOnLogin", "set": "setLaunchOnLogin" },
      "protected": true,
      "externalSource": "window.loginItemAPI"
    }
  ]
}

