{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": [
        "src/main/index.ts",
        "src/preload/index.ts",
        "src/renderer/index.ts",
        "scripts/*.js",
        "tests/support/**/*.{js,ts}",
        "tests/**/*.{test,spec}.{js,ts}"
      ],
      "project": ["src/**/*.{ts,js}"],
      "ignoreDependencies": ["eventemitter3", "@electron/notarize", "ffmpeg-static", "ffprobe-static"],
      "ignoreUnresolved": ["/overlay-icons/default.svg?url", "/Logo.png?url"]
    },
    "packages/prismgb-gpu": {
      "entry": ["src/index.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/prismgb-core": {
      "entry": ["src/index.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/*": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    }
  },
  "ignore": [
    "packages/prismgb-gpu/src/application/index.ts",
    "packages/prismgb-gpu/src/domain/index.ts",
    "packages/prismgb-gpu/src/infrastructure/canvas2d/index.ts",
    "packages/prismgb-gpu/src/infrastructure/index.ts",
    "packages/prismgb-gpu/src/infrastructure/webgl2/index.ts",
    "packages/prismgb-gpu/src/infrastructure/webgpu/index.ts",
    "**/*.d.ts",
    "dist/**",
    "release/**",
    "tests/fixtures/**"
  ]
}
