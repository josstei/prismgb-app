{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/main/index.ts",
        "src/preload/index.ts",
        "src/renderer/index.ts",
        "src/renderer/di.generated.ts",
        "scripts/*.js",
        "vite.config.js",
        "vitest.config.js",
        "playwright.config.js"
      ],
      "project": ["src/**/*.{ts,js}"]
    },
    "packages/*": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    }
  },
  "ignore": ["**/*.generated.ts", "**/*.d.ts", "dist/**", "release/**", "tests/fixtures/**"]
}
