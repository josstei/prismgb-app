{
  "name": "@prismgb/ui-base",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./reactive": {
      "import": "./dist/reactive/index.js",
      "types": "./dist/reactive/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@prismgb/core": "*"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.3.3",
    "vitest": "^4.0.0",
    "happy-dom": "^20.9.0"
  }
}
