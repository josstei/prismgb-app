{
  "name": "@prismgb/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PrismGB platform core: decorators, EventBus, Logger interface, PrismgbModule manifest.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json"
  },
  "peerDependencies": {
    "mitt": "^3.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tsyringe": "^4.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.4",
    "mitt": "^3.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tsyringe": "^4.8.0",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.5.0",
    "vite": "^7.3.2",
    "vitest": "^4.0.14",
    "zod": "^4.0.0"
  }
}
