{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": ".",
    "outDir": "dist/typecheck",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@main/*": [
        "src/main/*"
      ],
      "@renderer/*": [
        "src/renderer/*"
      ],
      "@preload/*": [
        "src/preload/*"
      ],
      "@shared/*": [
        "src/shared/*"
      ],
      "@prismgb/gpu": [
        "packages/prismgb-gpu/dist/index.d.ts"
      ],
      "@prismgb/gpu/*": [
        "packages/prismgb-gpu/dist/*"
      ],
      "@prismgb/core": [
        "packages/prismgb-core/dist/index.d.ts"
      ],
      "@prismgb/core/*": [
        "packages/prismgb-core/dist/*"
      ],
      "@prismgb/di": [
        "packages/prismgb-di/dist/index.d.ts"
      ],
      "@prismgb/di/*": [
        "packages/prismgb-di/dist/*"
      ],
      "@prismgb/ipc": [
        "packages/prismgb-ipc/dist/index.d.ts"
      ],
      "@prismgb/ipc/*": [
        "packages/prismgb-ipc/dist/*"
      ],
      "@prismgb/devices": [
        "packages/prismgb-devices/dist/index.d.ts"
      ],
      "@prismgb/devices/*": [
        "packages/prismgb-devices/dist/*"
      ],
      "@prismgb/stream-source": [
        "packages/prismgb-stream-source/dist/index.d.ts"
      ],
      "@prismgb/stream-source/*": [
        "packages/prismgb-stream-source/dist/*"
      ]
    },
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": false,
    "exactOptionalPropertyTypes": false,
    "declaration": false,
    "declarationMap": false,
    "allowImportingTsExtensions": false,
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "src/main/**/*.ts",
    "src/renderer/**/*.ts",
    "src/shared/**/*.ts",
    "src/types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests"
  ]
}
