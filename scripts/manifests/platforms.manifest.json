{
  "version": 1,
  "mode": "report-only",
  "platformGroups": {
    "all": ["linux-x64", "linux-arm64", "macos-x64", "macos-arm64", "windows-x64"],
    "linux": ["linux-x64", "linux-arm64"],
    "macos": ["macos-x64", "macos-arm64"],
    "windows": ["windows-x64"]
  },
  "smokeInputAliases": {
    "windows": "windows-x64"
  },
  "platforms": [
    {
      "id": "linux-x64",
      "label": "linux-x64",
      "name": "Linux x64",
      "os": "ubuntu-latest",
      "arch": "x64",
      "buildScript": "build:linux",
      "electronBuilderTargets": ["AppImage", "deb", "tar.gz"],
      "artifactGlobs": ["release/*.AppImage", "release/*.deb", "release/*.tar.gz", "release/latest-linux*.yml"],
      "smokeExecutablePriority": ["release/*.AppImage", "release/linux-unpacked/prismgb"]
    },
    {
      "id": "linux-arm64",
      "label": "linux-arm64",
      "name": "Linux ARM64",
      "os": "ubuntu-24.04-arm",
      "arch": "arm64",
      "buildScript": "build:linux",
      "electronBuilderTargets": ["AppImage", "deb", "tar.gz"],
      "artifactGlobs": ["release/*.AppImage", "release/*.deb", "release/*.tar.gz", "release/latest-linux*.yml"],
      "smokeExecutablePriority": ["release/*.AppImage", "release/linux-unpacked/prismgb"]
    },
    {
      "id": "macos-x64",
      "label": "macos-x64",
      "name": "macOS x64",
      "os": "macos-15-intel",
      "arch": "x64",
      "buildScript": "build:mac",
      "electronBuilderTargets": ["dmg", "zip"],
      "artifactGlobs": ["release/*.dmg", "release/*.zip", "release/latest-mac*.yml"],
      "smokeExecutablePriority": ["release/mac/*.app/Contents/MacOS/PrismGB"]
    },
    {
      "id": "macos-arm64",
      "label": "macos-arm64",
      "name": "macOS ARM64",
      "os": "macos-15",
      "arch": "arm64",
      "buildScript": "build:mac",
      "electronBuilderTargets": ["dmg", "zip"],
      "artifactGlobs": ["release/*.dmg", "release/*.zip", "release/latest-mac*.yml"],
      "smokeExecutablePriority": ["release/mac-arm64/*.app/Contents/MacOS/PrismGB"]
    },
    {
      "id": "windows-x64",
      "label": "windows-x64",
      "smokeInput": "windows",
      "name": "Windows x64",
      "os": "windows-latest",
      "arch": "x64",
      "buildScript": "build:win",
      "electronBuilderTargets": ["nsis:x64", "portable:x64"],
      "artifactGlobs": ["release/*.exe", "release/latest.yml"],
      "smokeExecutablePriority": ["release/*-portable.exe", "release/win-unpacked/PrismGB.exe"]
    }
  ]
}

