{
  "version": 1,
  "mode": "report-only",
  "aliases": [
    {
      "id": "@",
      "targets": {
        "tsBase": "./src/*",
        "tsApp": "./src/*",
        "vite": "src",
        "vitest": "src"
      }
    },
    {
      "id": "@main",
      "targets": {
        "tsBase": "./src/main/*",
        "tsApp": "./src/main/*",
        "vite": "src/main",
        "vitest": "src/main"
      }
    },
    {
      "id": "@renderer",
      "targets": {
        "tsBase": "./src/renderer/*",
        "tsApp": "./src/renderer/*",
        "vite": "src/renderer",
        "vitest": "src/renderer"
      }
    },
    {
      "id": "@preload",
      "targets": {
        "tsBase": "./src/preload/*",
        "tsApp": "./src/preload/*",
        "vite": "src/preload",
        "vitest": "src/preload"
      }
    },
    {
      "id": "@shared",
      "targets": {
        "tsBase": "./src/shared/*",
        "tsApp": "./src/shared/*",
        "vite": "src/shared",
        "vitest": "src/shared"
      }
    },
    {
      "id": "@prismgb/gpu",
      "targets": {
        "tsBase": "./packages/prismgb-gpu/src",
        "tsApp": "./packages/prismgb-gpu/dist/index.d.ts",
        "vite": "packages/prismgb-gpu/src/index.ts",
        "vitest": "packages/prismgb-gpu/src/index.ts"
      },
      "policy": "source in Vite/Vitest, dist declarations in app typecheck"
    },
    {
      "id": "url",
      "targets": {
        "viteRenderer": "url/"
      },
      "policy": "renderer-only browser polyfill"
    }
  ],
  "retiredAliases": [
    {
      "id": "@core",
      "policy": "forbidden in source imports"
    }
  ],
  "layers": [
    { "id": "main/entry", "sourcePrefix": "main/index" },
    { "id": "main/application", "sourcePrefix": "main/application" },
    { "id": "main/infrastructure", "sourcePrefix": "main/infrastructure" },
    { "id": "main/ipc", "sourcePrefix": "main/ipc" },
    { "id": "renderer/entry", "sourcePrefix": "renderer/index" },
    { "id": "renderer/application", "sourcePrefix": "renderer/application" },
    { "id": "renderer/infrastructure", "sourcePrefix": "renderer/infrastructure" },
    { "id": "renderer/presentation", "sourcePrefix": "renderer/presentation" },
    { "id": "shared", "sourcePrefix": "shared" },
    { "id": "preload", "sourcePrefix": "preload" }
  ]
}

